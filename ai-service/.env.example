# CLIP model from sentence-transformers. No API keys are required.
AI_MODEL_NAME=clip-ViT-B-32

# Set true to download/load the model during application startup instead of first use.
AI_MODEL_LOAD_ON_STARTUP=false

# Optional PyTorch device, such as cpu or cuda. Leave unset for automatic selection.
# AI_DEVICE=cpu

# Maximum size of any HTTP request body, including JSON/base64 overhead.
AI_MAX_REQUEST_BYTES=7340032
